# Production Environment - Root Domain
# Used by: npm run build:prod
# Deploy to: /public_html/ (root directory)

NEXT_PUBLIC_ENV_MODE=production
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_PHP_BACKEND_URL=https://crystalkeepsakes.com

# Stripe Live Keys (REQUIRED for production)
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY_HERE
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE

# Cockpit3D (Production)
NEXT_PUBLIC_COCKPIT3D_SHOP_ID=your_shop_id
COCKPIT3D_API_TOKEN=your_token
COCKPIT3D_RETAIL_ID=your_retail_id
