# Testing Environment - /test Subdirectory
# Used by: npm run build:test
# Deploy to: /public_html/test/

NEXT_PUBLIC_ENV_MODE=testing
NEXT_PUBLIC_BASE_PATH=/test
NEXT_PUBLIC_PHP_BACKEND_URL=https://yourdomain.com/test

# Stripe Test Keys (Use test keys for testing environment)
STRIPE_DEVELOPMENT_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE
STRIPE_DEVELOPMENT_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_STRIPE_DEVELOPMENT_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE

# Cockpit3D (Testing - can use production credentials)
NEXT_PUBLIC_COCKPIT3D_SHOP_ID=your_shop_id
COCKPIT3D_API_TOKEN=your_token
COCKPIT3D_RETAIL_ID=your_retail_id
