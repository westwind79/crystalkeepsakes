# Crystal Keepsakes - MAMP Local Development
# This .htaccess is for LOCAL DEVELOPMENT ONLY
# NO HTTPS redirect - keep HTTP for localhost

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # ============================================
  # CRITICAL: NO HTTPS REDIRECT FOR LOCAL DEV
  # ============================================
  # DO NOT uncomment this for local development!
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # ============================================
  # ALLOW PHP FILES TO EXECUTE
  # ============================================
  # Let PHP files run normally (Stripe, contact form, etc)
  RewriteCond %{REQUEST_FILENAME} \.php$
  RewriteRule ^ - [L]
  
  # ============================================
  # SERVE FILES DIRECTLY
  # ============================================
  # If file exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  
  # If directory exists, serve it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# ============================================
# SECURITY - Protect sensitive files
# ============================================
<FilesMatch "\.(env|sql|md|log|json|lock)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ============================================
# ALLOW IMAGES
# ============================================
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
  Order Allow,Deny
  Allow from all
</FilesMatch>

# ============================================
# PHP CONFIGURATION
# ============================================
# Memory and upload limits for images
php_value memory_limit 256M
php_value upload_max_filesize 10M
php_value post_max_size 10M

# Error logging (not display)
php_flag display_errors Off
php_flag log_errors On

# ============================================
# DISABLE DIRECTORY BROWSING
# ============================================
Options -Indexes
