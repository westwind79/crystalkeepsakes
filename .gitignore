.tsc-tmp/
next-env.d.ts

# Node Package Managers
.npm/
.node_repl_history
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
pnpm-lock.yaml

# Testing & Coverage
coverage/
.nyc_output/

# Production Files (GoDaddy)
public_html/
cgi-bin/

# SSL Certificates
*.pem
*.key
*.crt
*.cer
!*.example.*

# Database
*.sql
*.sqlite
*.db

# Backups
*.backup
*.bak
*.old

# Documentation
docs/_build/

# PHP/Composer
composer.lock

# Order Data (Temporary cart storage)
api/order-data/

# Misc Runtime
*.pid
*.seed
*.pid.lock

# MAMP Specific
.htaccess.bak

# Emergent Platform
