# ============================================
# Crystal Keepsakes - Git Ignore
# ============================================

# Dependencies
node_modules/
vendor/
# Keep yarn.lock for reproducible builds
# But ignore package-lock.json since we use yarn
package-lock.json

# Next.js Build Outputs
.next/
out/
out-test/
out-prod/
.turbo/
tsconfig.tsbuildinfo

# Admin Panel (should NOT be in production builds)
out-prod/admin/
out-test/admin/

# Environment Variables
.env
.env.local
.env.production
.env.production.local
.env.development
.env.development.local
.env.test
.env.test.local
*.env
*.env.*

# Product Data (Edited in Admin - Don't Commit)
src/data/final-product-list.js
public/data/products.json
public/data/final-products*.json

# Uploaded Images (Don't Commit User Uploads)
public/uploads/
public/img/products/cockpit3d/*/product_*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/var/log/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Cache & Temp Files
.cache/
.temp/
*.tmp

# Backups
*.backup
*.bak
*.old
*~

# PHP
composer.lock

# Testing
coverage/
.nyc_output/

# Misc
*.pid
*.seed
*.pid.lock
-e 
