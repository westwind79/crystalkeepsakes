# Dependencies
node_modules/
vendor/

# Lock files - Keep yarn.lock, ignore npm
package-lock.json

# Next.js Build Outputs
.next/
out/
out-prod/
out-test/
build/
dist/
.emergent/

# ADD THESE:
out-prod/vendor/
out-test/vendor/
out/vendor/

# Environment Variables (NEVER commit real credentials)
.env
.env.local
.env.production
.env.production.test
.env.development
.env.development.local
.env.test
.env.test.local
*.env
!.env.example

# Product Data (Generated/Edited - Don't Commit)
src/data/final-product-list.js
public/data/products.json
public/data/final-products*.json

# PHP Configuration
config/*.php
!config/*.example.php

# User Uploads (CRITICAL - Don't commit customer images)
public/uploads/
public/img/products/cockpit3d/*/product_*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
/var/log/
php_error.log

