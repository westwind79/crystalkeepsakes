# Crystal Keepsakes Environment Variables
# Copy this file to .env.local for local development
# DO NOT commit .env.local or .env with real credentials!

# ========================================
# ENVIRONMENT MODE
# ========================================
# Options: development | testing | production
# - development: Local dev with test Stripe keys (localhost:3000 or MAMP)
# - testing: Staging environment on production server (/test subdirectory)
# - production: Live production site
NEXT_PUBLIC_ENV_MODE=development

# ========================================
# BASE PATH (for subdirectory deployment)
# ========================================
# Leave empty for root deployment
# Set to /test for /test subdirectory
# Set to /crystalkeepsakes for /crystalkeepsakes subdirectory
NEXT_PUBLIC_BASE_PATH=

# ========================================
# BACKEND URL
# ========================================
# Local Development (MAMP):
#   NEXT_PUBLIC_PHP_BACKEND_URL=http://localhost:8888/crystalkeepsakes
# 
# Local Development (standalone PHP):
#   NEXT_PUBLIC_PHP_BACKEND_URL=http://localhost:8000
#
# Testing subdirectory:
#   NEXT_PUBLIC_PHP_BACKEND_URL=https://yourdomain.com/test
#
# Production:
#   NEXT_PUBLIC_PHP_BACKEND_URL=https://crystalkeepsakes.com
NEXT_PUBLIC_PHP_BACKEND_URL=http://localhost:8888/crystalkeepsakes

# ========================================
# STRIPE KEYS - DEVELOPMENT/TEST
# ========================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE
STRIPE_DEVELOPMENT_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE
STRIPE_DEVELOPMENT_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_STRIPE_DEVELOPMENT_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE

# ========================================
# STRIPE KEYS - PRODUCTION (LIVE)
# ========================================
# Get live keys from: https://dashboard.stripe.com/apikeys
# ONLY use these in production environment!
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY_HERE
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE

# ========================================
# STRIPE WEBHOOK SECRET
# ========================================
# Get from: Stripe Dashboard → Developers → Webhooks
# Create endpoint for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ========================================
# COCKPIT3D API CREDENTIALS
# ========================================
# Get your credentials from: https://cockpit3d.com
NEXT_PUBLIC_COCKPIT3D_SHOP_ID=your_shop_id_here
COCKPIT3D_API_TOKEN=your_api_token_here
COCKPIT3D_RETAIL_ID=your_retail_id_here
COCKPIT3D_USERNAME=your_email@example.com
COCKPIT3D_PASSWORD=your_password_here

# ========================================
# DATABASE CREDENTIALS (Optional)
# ========================================
# For storing orders in database
DB_HOST=localhost
DB_NAME=crystal_orders
DB_USER=your_db_user
DB_PASS=your_db_password

# ========================================
# EMAIL/SMTP SETTINGS (Optional)
# ========================================
# For order confirmation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@crystalkeepsakes.com
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=orders@crystalkeepsakes.com
SMTP_FROM_NAME=Crystal Keepsakes

# ========================================
# DEPLOYMENT NOTES
# ========================================
# 
# LOCAL DEVELOPMENT (MAMP):
# 1. Copy this file to .env.local
# 2. Fill in your test Stripe keys
# 3. Set NEXT_PUBLIC_PHP_BACKEND_URL=http://localhost:8888/crystalkeepsakes
# 4. Run: yarn dev
#
# TESTING ENVIRONMENT (/test subdirectory):
# 1. Create .env file on server
# 2. Set NEXT_PUBLIC_ENV_MODE=testing
# 3. Set NEXT_PUBLIC_BASE_PATH=/test
# 4. Set NEXT_PUBLIC_PHP_BACKEND_URL=https://yourdomain.com/test
# 5. Use test Stripe keys
# 6. Build: yarn build
#
# PRODUCTION:
# 1. Create .env file on server
# 2. Set NEXT_PUBLIC_ENV_MODE=production
# 3. Leave NEXT_PUBLIC_BASE_PATH empty
# 4. Set NEXT_PUBLIC_PHP_BACKEND_URL=https://crystalkeepsakes.com
# 5. Use LIVE Stripe keys (sk_live_* and pk_live_*)
# 6. Build: yarn build
#
# IMPORTANT STRIPE REDIRECT FIX:
# The Stripe checkout will now automatically detect the correct
# environment and redirect back to the proper URL, whether it's:
# - http://localhost:3000 (dev)
# - http://localhost:8888/crystalkeepsakes (MAMP)
# - https://yourdomain.com/test (testing)
# - https://crystalkeepsakes.com (production)
