# API Directory - CORS & Rewrite Configuration
# This prevents parent .htaccess rules from affecting API requests

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Allow direct access to PHP files - NO redirects for API
  # This prevents the "Redirect is not allowed for preflight request" error
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule .* - [L]
</IfModule>

# CORS Headers (Handled in PHP but this is a backup)
<IfModule mod_headers.c>
  # Handle OPTIONS requests for CORS preflight
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "POST, GET, OPTIONS, DELETE, PUT"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
  Header always set Access-Control-Allow-Credentials "true"
  
  # Respond to OPTIONS requests immediately (no PHP processing)
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# Prevent parent .htaccess rules from applying
RewriteOptions Inherit
